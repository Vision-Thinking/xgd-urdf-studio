# URDF Studio 独立镜像与容器参数。
URDF_STUDIO_IMAGE=xgd-urdf-studio:dev
URDF_STUDIO_CONTAINER_NAME=urdf-studio
URDF_STUDIO_BIND_ADDRESS=0.0.0.0
URDF_STUDIO_HTTPS_PORT=8320

# 该地址由 isaac-sim-env 的 8318 Studio 用于打开新窗口；正式域名后续替换。
URDF_STUDIO_PUBLIC_URL=https://localhost:8320

# 证书只在运行时只读挂载，不进入镜像；开发阶段可由 mkcert 生成。
URDF_STUDIO_TLS_CERT_PATH=./.dev-certs/tls.crt
URDF_STUDIO_TLS_KEY_PATH=./.dev-certs/tls.key
